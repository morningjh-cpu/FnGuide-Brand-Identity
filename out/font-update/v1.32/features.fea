# ---- f 합자 (긴 조합 우선) ----
feature liga {
    sub f f i by f_f_i;
    sub f f l by f_f_l;
    sub f f by f_f;
    sub f i by f_i;
    sub f t by f_t;
    sub f j by f_j;
    sub f l by f_l;
    sub f b by f_b;
    sub f h by f_h;
    sub f k by f_k;
} liga;

# ---- v1.3: 고정폭 숫자 (선택 기능, 표에서 켬) ----
feature tnum {
    sub zero by zero.tf;
    sub one by one.tf;
    sub two by two.tf;
    sub three by three.tf;
    sub four by four.tf;
    sub five by five.tf;
    sub six by six.tf;
    sub seven by seven.tf;
    sub eight by eight.tf;
    sub nine by nine.tf;
    sub plus by plus.tf;
    sub minus by minus.tf;
    sub plusminus by plusminus.tf;
} tnum;
